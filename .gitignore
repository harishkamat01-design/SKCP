# ============================================
# Node.js Dependencies
# Installed automatically using npm install.
# Can always be recreated from package.json.
# ============================================
node_modules/
npm-debug.log*

# ============================================
# Environment Variables
# Stores secrets like API keys and passwords.
# Never commit these to GitHub.
# ============================================
.env
.env.*

# ============================================
# Build Output
# Generated automatically during production build.
# No need to store generated files in Git.
# ============================================
dist/
build/

# ============================================
# Java / Spring Boot Build Output
# Generated during Maven builds.
# ============================================
target/
*.class
*.jar
*.war
*.ear

# ============================================
# Test Coverage Reports
# Generated after running automated tests.
# Can always be regenerated.
# ============================================
coverage/

# ============================================
# IDE Files
# Personal editor configuration.
# ============================================
.vscode/
.idea/
*.iml

# ============================================
# Operating System Files
# Automatically created by Windows/macOS.
# ============================================
.DS_Store
Thumbs.db

# ============================================
# CommandCode Workspace
# Local AI coding assistant configuration.
# ============================================
.commandcode/

# ============================================
# HTTP Forge Workspace
# Local HTTP request collections.
# ============================================
.http-forge/

# ============================================
# Logs
# ============================================
logs/
*.log

# ============================================
# Maven Wrapper Cache
# Ignore wrapper JAR if desired.
# Maven will download it automatically.
# ============================================
.mvn/wrapper/maven-wrapper.jar