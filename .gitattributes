# ==========================================================
# SKCP Project - Root Git Attributes
# Purpose:
#   - Normalize text files
#   - Preserve correct line endings
#   - Prevent OS-specific issues
# ==========================================================

# Auto detect text files
* text=auto

# ==========================================================
# Source Code
# ==========================================================

*.java          text
*.js            text
*.jsx           text
*.ts            text
*.tsx           text
*.html          text
*.css           text
*.scss          text

# ==========================================================
# Configuration Files
# ==========================================================

*.json          text
*.xml           text
*.properties    text
*.yml           text
*.yaml          text
*.sql           text

# Documentation
*.md            text

# Git files
.gitattributes  text
.gitignore      text

# ==========================================================
# Scripts
# ==========================================================

# Linux / macOS
*.sh            text eol=lf

# Windows
*.bat           text eol=crlf
*.cmd           text eol=crlf

# ==========================================================
# Binary Files
# (Never modify line endings)
# ==========================================================

*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.zip           binary
*.jar           binary

# ==========================================================
# Office Files
# ==========================================================

*.docx          binary
*.xlsx          binary
*.pptx          binary