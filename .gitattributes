# ============================================
# SKCP Git Attributes
# ============================================

# Automatically detect text files and normalize line endings
* text=auto

# ============================================
# Source Code
# ============================================

# Java
*.java text

# JavaScript
*.js text

# JSX
*.jsx text

# TypeScript
*.ts text
*.tsx text

# HTML
*.html text

# CSS
*.css text

# ============================================
# Configuration Files
# ============================================

# JSON
*.json text

# YAML
*.yml text
*.yaml text

# Spring Boot Properties
*.properties text

# XML (pom.xml, configuration files)
*.xml text

# Markdown
*.md text

# Git configuration files
.gitattributes text
.gitignore text

# ============================================
# Scripts
# ============================================

# Shell scripts (Linux/macOS)
*.sh text eol=lf

# Windows batch files
*.bat text eol=crlf

# Windows command files (Maven Wrapper)
*.cmd text eol=crlf